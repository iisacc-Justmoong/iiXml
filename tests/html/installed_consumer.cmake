if(NOT DEFINED IIXML_SOURCE OR NOT DEFINED IIXML_BINARY)
    message(FATAL_ERROR "Missing iiXml source or build directory")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
set(_root "${IIXML_BINARY}/html-consumer-${_id}")
set(_prefix "${_root}/prefix")
file(MAKE_DIRECTORY "${_root}")
function(run_checked)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGN}\n${output}\n${error}")
    endif()
endfunction()
run_checked("${CMAKE_COMMAND}" --install "${IIXML_BINARY}" --prefix "${_prefix}")
foreach(_file IN ITEMS share/licenses/iiXml/LICENSE share/iiXml/docs/HtmlBlockIntegration.md
        share/iiXml/docs/HtmlBlockIntegration.agent.json share/iiXml/docs/HtmlBlock/install.md)
    if(NOT EXISTS "${_prefix}/${_file}")
        message(FATAL_ERROR "Integrated license or documentation missing: ${_file}")
    endif()
endforeach()
file(READ "${_prefix}/share/iiXml/docs/HtmlBlockIntegration.agent.json" _agent_document)
string(JSON _agent_source GET "${_agent_document}" source path)
if(NOT _agent_source STREQUAL "docs/HtmlBlockIntegration.md")
    message(FATAL_ERROR "Installed agent documentation references the wrong source: ${_agent_source}")
endif()
run_checked("${CMAKE_COMMAND}" -S "${IIXML_SOURCE}/tests/html/consumer" -B "${_root}/build"
    "-DCMAKE_PREFIX_PATH=${_prefix}" "-DQt6_DIR=${QT6_DIR}" "-DCMAKE_DISABLE_FIND_PACKAGE_iiFileProvider=TRUE")
run_checked("${CMAKE_COMMAND}" --build "${_root}/build" --parallel 2)
run_checked("${CMAKE_COMMAND}" -E env --unset=DYLD_LIBRARY_PATH --unset=DYLD_FRAMEWORK_PATH
    --unset=DYLD_FALLBACK_LIBRARY_PATH ctest --test-dir "${_root}/build" --output-on-failure)
file(REMOVE_RECURSE "${_root}")
