      "id": "b000043",
      "kind": "fenced_code",
      "start_line": 63,
      "end_line": 75,
      "raw": "```cpp\n#include <iiXml>\n\niiXml::Writer::GetFile input;\n\nQObject::connect(&input, &iiXml::Writer::GetFile::Parsed,\n    [](const QString& TagName, const QString& Value) {\n        // TagName == \"XML\"\n        // Value == \"<number>1</number>\"\n    });\n\ninput.ReadXml(\"<!Doctype XML>\\n<XML><number>1</number></XML>\");\n```\n",
      "language": "cpp",
      "code": "#include <iiXml>\n\niiXml::Writer::GetFile input;\n\nQObject::connect(&input, &iiXml::Writer::GetFile::Parsed,\n    [](const QString& TagName, const QString& Value) {\n        // TagName == \"XML\"\n        // Value == \"<number>1</number>\"\n    });\n\ninput.ReadXml(\"<!Doctype XML>\\n<XML><number>1</number></XML>\");\n",
      "closed": true
    },
