    },
    {
      "id": "b000065",
      "kind": "list",
      "start_line": 78,
      "end_line": 79,
      "raw": "- `CloseOpenTag(std::vector<std::string>& OpenTags, std::string_view ClosingTagName)`\n- `ParseOpenTags(std::string_view Input)`\n",
      "items": [
        {
          "marker": "-",
          "text": "`CloseOpenTag(std::vector<std::string>& OpenTags, std::string_view ClosingTagName)`",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`ParseOpenTags(std::string_view Input)`",
          "checked": null
