          "checked": null
        },
        {
          "marker": "-",
          "text": "`ParseAllResult(std::string_view Input)`",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`ParseAllDocument(std::string_view Input)`",
          "checked": null
        },
