          "marker": "-",
          "text": "`ParseAllDocumentResult(std::string_view Input)`",
          "checked": null
        }
      ]
    },
    {
      "id": "b000022",
      "kind": "blank",
      "start_line": 30,
      "end_line": 30,
      "raw": "\n"
    },
    {
      "id": "b000023",
      "kind": "paragraph",
      "start_line": 31,
      "end_line": 31,
      "raw": "`ParseAll()`은 `OpenTag`의 교차 종료 정책을 사용하여 `<a><b></a></b>`에서도 `a`와 `b`를 모두 반환한다. 반환 타입은 `std::vector<TagNode>`이며, 각 노드는 `Range`, `Fields`, `Children`을 가진다. `Value/Raw` 문자열과 field 값은 복사하지 않고 원본 입력의 offset 범위로 제공한다.\n"
    },
    {
      "id": "b000024",
      "kind": "blank",
      "start_line": 32,
      "end_line": 32,
      "raw": "\n"
    },
    {
      "id": "b000025",
      "kind": "paragraph",
      "start_line": 33,
      "end_line": 33,
      "raw": "Result API는 `TagParseResult`와 `TagTreeParseResult`를 반환한다. 각 Result는 `Status`, 성공 payload(`Token` 또는 `Nodes`), 실패 위치를 담은 `Diagnostic`을 가진다.\n"
    },
    {
      "id": "b000026",
      "kind": "blank",
      "start_line": 34,
      "end_line": 34,
      "raw": "\n"
    },
    {
      "id": "b000027",
      "kind": "paragraph",
      "start_line": 35,
      "end_line": 35,
      "raw": "`ParseAllDocument()`와 `ParseAllDocumentResult()`는 range 기반 결과를 `TagDocument`로 감싼다. `TagDocument`는 입력 원문을 `Source`에 한 번만 소유하고 `Nodes`에 range 트리를 담기 때문에, 다른 프로젝트의 도메인 객체에 통째로 멤버로 보관할 수 있다. 값 접근은 `RawView()`, `ValueView()`, `FieldNameView()`, `FieldValueView()`로 수행한다.\n"
    },
    {
      "id": "b000028",
      "kind": "blank",
      "start_line": 36,
      "end_line": 36,
      "raw": "\n"
    },
    {
