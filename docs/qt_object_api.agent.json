      "start_line": 21,
      "end_line": 21,
      "raw": "\n"
    },
    {
      "id": "b000019",
      "kind": "paragraph",
      "start_line": 22,
      "end_line": 22,
      "raw": "동기 API:\n"
    },
    {
      "id": "b000020",
      "kind": "blank",
      "start_line": 23,
      "end_line": 23,
      "raw": "\n"
    },
    {
      "id": "b000021",
      "kind": "list",
      "start_line": 24,
      "end_line": 29,
      "raw": "- `Parse(std::string_view Input)`\n- `ParseResult(std::string_view Input)`\n- `ParseAll(std::string_view Input)`\n- `ParseAllResult(std::string_view Input)`\n- `ParseAllDocument(std::string_view Input)`\n- `ParseAllDocumentResult(std::string_view Input)`\n",
      "items": [
        {
          "marker": "-",
          "text": "`Parse(std::string_view Input)`",
          "checked": null
        },
        {
          "marker": "-",
          "text": "`ParseResult(std::string_view Input)`",
          "checked": null
        },
        {
          "marker": "-",
