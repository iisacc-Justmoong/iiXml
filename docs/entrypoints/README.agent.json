    },
    {
      "id": "b000021",
      "kind": "paragraph",
      "start_line": 34,
      "end_line": 34,
      "raw": "The self-written code and documents of iiXml are distributed under the MIT License ( `MIT` ). The full terms follow [LICENSE](LICENSE).\n"
    },
    {
      "id": "b000022",
      "kind": "blank",
      "start_line": 35,
