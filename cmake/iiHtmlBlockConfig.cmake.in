@PACKAGE_INIT@
# The compatibility name is installed with iiXml. Load that installation's
# targets through its config so that platform dispatch and Qt setup are shared.
if(NOT TARGET iiXml::HtmlBlock)
    include("${CMAKE_CURRENT_LIST_DIR}/../iiXml/iiXmlConfig.cmake" OPTIONAL)
endif()
if(NOT TARGET iiXml::HtmlBlock)
    set(iiHtmlBlock_FOUND FALSE)
    set(iiHtmlBlock_NOT_FOUND_MESSAGE "The co-installed iiXml package must provide iiXml::HtmlBlock")
    return()
endif()
if(NOT TARGET iiHtmlBlock::iiHtmlBlock)
    add_library(iiHtmlBlock::iiHtmlBlock INTERFACE IMPORTED)
    set_property(TARGET iiHtmlBlock::iiHtmlBlock PROPERTY INTERFACE_LINK_LIBRARIES iiXml::HtmlBlock)
endif()
check_required_components(iiHtmlBlock)
